{
  "name": "google-github-sync",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "prepare": "effect-language-service patch",
    "format": "biome format --write",
    "lint": "biome lint",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/web dev",
    "db:push": "bun run --cwd packages/server db:push",
    "db:studio": "bun run --cwd packages/server db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@effect/language-service": "^0.64.1",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
