{
  "name": "google-github-sync",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "format": "biome format --write",
    "lint": "biome lint",
    "test": "bun test --recursive",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/bff && tsc --noEmit -p packages/worker && tsc --noEmit -p packages/web",
    "dev:bff": "bun run --cwd packages/bff dev",
    "dev:worker": "bun run --cwd packages/worker dev",
    "dev:web": "bun run --cwd packages/web dev",
    "dev": "bun run dev:bff & bun run dev:worker & bun run dev:web",
    "db:push": "bun run --cwd packages/shared db:push",
    "db:studio": "bun run --cwd packages/shared db:studio",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/tsgo": "^0.53.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "knip": "^6.41.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "qs": "6.16.1",
    "shell-quote": "1.12.0",
    "baseline-browser-mapping": "2.11.28",
    "source-map-js": "1.2.2",
    "esbuild": "0.28.2"
  }
}
